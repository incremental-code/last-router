{
  "name": "@incremental-code/last-router",
  "version": "1.0.0",
  "description": "An isomorphic file-system router for the last-js ecosystem.",
  "type": "module",
  "main": "src/server.js",
  "types": "src/server.d.ts",
  "exports": {
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./client": "./src/client.js",
    "./common": {
      "types": "./src/common.d.ts",
      "default": "./src/common.js"
    }
  },
  "scripts": {
    "demo": "node demo/index.js",
    "test": "node --test \"src/tests/*.test.js\""
  },
  "dependencies": {
    "@incremental-code/last-act": "file:../last-act",
    "signal-polyfill": "^0.2.2"
  }
}
